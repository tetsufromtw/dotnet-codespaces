{
    "name": ".NET in Codespaces",
    "image": "mcr.microsoft.com/dotnet/sdk:10.0",
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "2"
        },
        "ghcr.io/devcontainers/features/common-utils:2": {},
        "ghcr.io/devcontainers/features/dotnet:2": {
            "version": "none",
            "dotnetRuntimeVersions": "10.0",
            "aspNetCoreRuntimeVersions": "10.0"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.vscode-node-azure-pack",
                "GitHub.vscode-github-actions",
                "ms-dotnettools.csdevkit"
            ]
        }
    },
    "forwardPorts": [
        8080,
        8081,
        8082
    ],
    "postCreateCommand": "cd ./SampleApp && dotnet restore",
    "remoteEnv": {
        "DOTNET_MULTILEVEL_LOOKUP": "0",
        "TARGET": "net10.0"
    },
    "portsAttributes": {
        "8080": {
            "label": "Transaction Integration API",
            "onAutoForward": "notify"
        },
        "8081": {
            "label": "Transaction Console",
            "onAutoForward": "notify"
        },
        "8082": {
            "label": "Partner Bank Stub",
            "onAutoForward": "notify"
        }
    }
}
